{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "岗位变更回放清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "provenance",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "mode": {
      "const": "replay"
    },
    "provenance": {
      "type": "object",
      "required": [
        "sourceId",
        "sourceUrl",
        "collectedAt",
        "snapshotFile",
        "sha256"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "minLength": 1
        },
        "collectedAt": {
          "type": "string",
          "minLength": 1
        },
        "snapshotFile": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stepId",
          "kind",
          "changes",
          "expected"
        ],
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "snapshot",
              "source_failure"
            ]
          },
          "snapshotFile": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "failureReason": {
            "type": "string",
            "minLength": 1
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "identity",
                "field",
                "before",
                "after"
              ],
              "properties": {
                "identity": {
                  "type": "string",
                  "minLength": 1
                },
                "field": {
                  "enum": [
                    "requirements",
                    "deadline",
                    "status"
                  ]
                },
                "before": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "after": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "snapshot"
                }
              }
            },
            "then": {
              "required": [
                "snapshotFile",
                "sha256"
              ],
              "not": {
                "required": [
                  "failureReason"
                ]
              }
            },
            "else": {
              "required": [
                "failureReason"
              ],
              "properties": {
                "changes": {
                  "maxItems": 0
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "snapshotFile"
                    ]
                  },
                  {
                    "required": [
                      "sha256"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
